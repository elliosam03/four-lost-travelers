}

class Boss5
{
    Boss5()
    attack(target : Character &) override : void
}

Mimic --|> Enemy : inherits
WildDog --|> Enemy : inherits
Skeleton --|> Enemy : inherits
Spider --|> Enemy : inherits
Goblin --|> Enemy : inherits
Scion --|> Enemy : inherits
Inferius --|> Enemy : inherits

Boss1 --|> Enemy : inherits
Boss2 --|> Enemy : inherits
Boss3 --|> Enemy : inherits
Boss4 --|> Enemy : inherits
Boss5 --|> Enemy : inherits

Enemy *-- AttackDecisionTree : owns

@enduml