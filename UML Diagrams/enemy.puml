@startuml Enemy
skinparam ClassAttributeIconSize 0

class Enemy 
{ 
    - enemyName : std::string
    - health : int
    - healthCapacity : int
    - damage : int
    - decisionTree : AttackDecisionTree

    + Enemy()
    + Enemy(name : std::string, healthCapacity : int, damage : int)
    + Enemy(other : const Enemy &)
    + operator=(other : const Enemy &) : Enemy &
    + ~Enemy() : {abstract}

    + getEnemyName() const : std::string
    + getHealth() const : int
    + getHealthCapacity() const : int
    + getDamage() const : int

    + attack(target : Character &) : {abstract} void
    + decideAttack() : std::string
    + performDecidedAttack(target : Character &) : void

    + takeDamage(damage : int) : void
    + isDead() const : bool

    <<friend>> operator<<(outputStream : std::ostream &, enemyToPrint : const Enemy &) : std::ostream &
}

class Mimic
{
    Mimic()
    attack(target : Character &) override : void
}

class Wolf
{
    Wolf()
    attack(target : Character &) override : void
}

class Skeleton
{
    Skeleton()
    attack(target : Character &) override : void
}

